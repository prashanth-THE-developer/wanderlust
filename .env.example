# Copy this file to ".env" and fill in your own values. Never commit the real .env file.

# MongoDB Atlas connection string (include the database name, e.g. /wanderlust_v2)
ATLASDB_URL=

# Any long random string (used to sign and encrypt sessions)
SECRET=

# Cloudinary (image uploads)
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Mapbox PUBLIC token (starts with pk.)
MAP_TOKEN=
