<% layout("layouts/boilerplate") %>

<div class="row mt-3">
  <div class="col-8 offset-2">
    <h3>Edit your Listing</h3>

    <form
      method="POST"
      action="/listings/<%= listing._id %>?_method=PUT"
      novalidate
      class="needs-validation"
      enctype="multipart/form-data"
    >
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input
          id="title"
          name="listing[title]"
          value="<%= listing.title %>"
          type="text"
          maxlength="100"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Title is required</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea
          id="description"
          name="listing[description]"
          class="form-control"
          maxlength="2000"
          required
        ><%= listing.description %></textarea>
        <div class="invalid-feedback">Description is required</div>
      </div>

      <div class="mb-3">
        Current image<br />
        <img src="<%= thumbUrl %>" alt="<%= listing.title %>" style="max-height: 300px; border-radius: 1rem" />
      </div>

      <div class="mb-3">
        <label for="image" class="form-label">Upload a new image (optional)</label>
        <input
          id="image"
          name="listing[image]"
          type="file"
          accept="image/png, image/jpeg, image/webp"
          class="form-control"
        />
      </div>

      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label">Price (per night)</label>
          <input
            id="price"
            name="listing[price]"
            value="<%= listing.price %>"
            type="number"
            min="0"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Valid price required</div>
        </div>

        <div class="mb-3 col-md-8">
          <label for="country" class="form-label">Country</label>
          <input
            id="country"
            name="listing[country]"
            value="<%= listing.country %>"
            type="text"
            maxlength="60"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Country is required</div>
        </div>
      </div>

      <div class="mb-3">
        <label for="location" class="form-label">Location</label>
        <input
          id="location"
          name="listing[location]"
          value="<%= listing.location %>"
          type="text"
          maxlength="100"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Location is required</div>
      </div>

      <button class="btn btn-dark edit-btn mt-3">Save changes</button>
    </form>
  </div>
</div>
